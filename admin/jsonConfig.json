{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_satellites": {
            "type": "panel",
            "label": "Satellites",
            "items": {
                "_satellitesIntro": {
                    "type": "staticText",
                    "text": "Satellites with the Waveshare voice firmware 2.0.0 or newer. The adapter connects next to ioBroker.assistant, the voice stays there.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "satellites": {
                    "type": "table",
                    "label": "Satellites",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "8%",
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Room or name",
                            "width": "25%",
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "host",
                            "title": "IP address",
                            "width": "25%",
                            "default": ""
                        },
                        {
                            "type": "number",
                            "attr": "port",
                            "title": "API port",
                            "width": "12%",
                            "min": 1,
                            "max": 65535,
                            "default": 6053
                        },
                        {
                            "type": "text",
                            "attr": "encryptionKey",
                            "title": "API encryption key (only when the firmware has one)",
                            "width": "30%",
                            "default": ""
                        }
                    ]
                }
            }
        },
        "_tiles": {
            "type": "panel",
            "label": "Tiles",
            "items": {
                "_tileEditor": {
                    "type": "custom",
                    "i18n": true,
                    "url": "custom/customComponents.js?v=0.0.3",
                    "name": "SatDisplay/Components/TileEditor",
                    "guiApi": 2,
                    "bundlerType": "module",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_tilesHelp": {
                    "type": "staticText",
                    "text": "A switch and a button write the state when touched (a button writes true). A dimmer takes its level from the state (0-100 or the range of the object) and its on/off from the second state; without a second state, a level of 0 is off.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_charts": {
            "type": "panel",
            "label": "Charts",
            "items": {
                "historyInstance": {
                    "type": "instance",
                    "adapter": "_dataSources",
                    "label": "History adapter for the charts",
                    "help": "Empty: a chart starts empty and draws the values as they come",
                    "allowDeactivate": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "chartHours": {
                    "type": "number",
                    "label": "Hours shown in a chart",
                    "min": 1,
                    "max": 168,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        }
    }
}
