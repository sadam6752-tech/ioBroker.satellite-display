{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_satellites": {
            "type": "panel",
            "label": "Satellites",
            "items": {
                "_satellitesIntro": {
                    "type": "staticText",
                    "text": "Satellites with the Waveshare voice firmware 2.0.0 or newer. The adapter connects next to ioBroker.assistant, the voice stays there.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "satellites": {
                    "type": "table",
                    "label": "Satellites",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "6%",
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Room or name",
                            "width": "18%",
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "host",
                            "title": "IP address",
                            "width": "16%",
                            "default": ""
                        },
                        {
                            "type": "number",
                            "attr": "port",
                            "title": "API port",
                            "width": "10%",
                            "min": 1,
                            "max": 65535,
                            "default": 6053
                        },
                        {
                            "type": "text",
                            "attr": "encryptionKey",
                            "title": "API encryption key (only when the firmware has one)",
                            "width": "20%",
                            "default": ""
                        },
                        {
                            "type": "checkbox",
                            "attr": "lockEnabled",
                            "title": "Screen lock",
                            "width": "10%",
                            "default": false
                        },
                        {
                            "type": "password",
                            "attr": "pin",
                            "title": "PIN (4-6 digits)",
                            "width": "20%",
                            "visible": true,
                            "default": ""
                        }
                    ]
                }
            }
        },
        "_tiles": {
            "type": "panel",
            "label": "Tiles",
            "items": {
                "_tileEditor": {
                    "type": "custom",
                    "i18n": true,
                    "url": "custom/customComponents.js?v=0.2.1",
                    "name": "SatDisplay/Components/TileEditor",
                    "guiApi": 2,
                    "bundlerType": "module",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_tilesHelp": {
                    "type": "staticText",
                    "text": "A switch and a button write the state when touched (a button writes true). A dimmer takes its level from the state (0-100 or the range of the object) and its on/off from the second state; without a second state, a level of 0 is off.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_charts": {
            "type": "panel",
            "label": "Charts",
            "items": {
                "historyInstance": {
                    "type": "instance",
                    "adapter": "_dataSources",
                    "label": "History adapter for the charts",
                    "help": "Empty: a chart starts empty and draws the values as they come",
                    "allowDeactivate": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "chartHours": {
                    "type": "number",
                    "label": "Hours shown in a chart",
                    "min": 1,
                    "max": 168,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_auth": {
            "type": "panel",
            "label": "Authentication",
            "items": {
                "_authIntro": {
                    "type": "staticText",
                    "text": "A satellite with \"Screen lock\" on (tab Satellites) shows only the clock and a lock and does not react to the wake word. A touch opens a keypad for its PIN. The satellite checks the PIN itself, also without ioBroker; after 5 wrong PINs it waits a minute.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "relockMode": {
                    "type": "select",
                    "label": "Lock the screen again",
                    "options": [
                        { "value": 0, "label": "After some minutes without a touch" },
                        { "value": 1, "label": "When the display goes back to the clock by itself" },
                        { "value": 2, "label": "Only by hand (the open lock next to the gear)" }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "relockMinutes": {
                    "type": "number",
                    "label": "Minutes without a touch",
                    "min": 1,
                    "max": 1440,
                    "hidden": "data.relockMode !== 0",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "_authHint": {
                    "type": "staticText",
                    "text": "The open lock next to the gear locks at once in every mode. The state satellites.<name>.locked shows the lock and locks or unlocks from ioBroker, e.g. at night.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_look": {
            "type": "panel",
            "label": "Appearance",
            "items": {
                "accentColor": {
                    "type": "color",
                    "label": "Main colour of the tiles",
                    "help": "Value, arc, bar, line and toggles. Empty: the blue of the satellite. A tile can have its own colour.",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        }
    }
}
